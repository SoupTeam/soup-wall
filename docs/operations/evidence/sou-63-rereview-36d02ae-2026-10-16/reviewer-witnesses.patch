+#[tokio::test]
+async fn review36_expired_child_authority_must_not_authorize_hooks() {
+    use agentfw::native::child_authority as ca;
+    let f=Fixture::new(ALLOW);
+    let (s,r)=review8dd_start(&f,"parent","parent-agent",None,&["read_document","Bash"],Some(vec![])).await;
+    assert_allow(s,&r);
+    let now=SystemTime::now().duration_since(UNIX_EPOCH).unwrap().as_millis() as u64;
+    let grant=ca::mint_scoped(&ca::derive_key(NATIVE_TOKEN),"review-host","resource-fixture",&["read_document".into(),"Bash".into()],now,500,"short-lived".into(),Some("worker".into()),Some("parent-agent".into()),Some(vec![]));
+    let mut start=f.event("short-child","session_start");
+    start["host_session"]=json!("review-host");start["server_id"]=json!("resource-fixture");start["child_authority"]=json!(ca::encode_token(&grant));
+    let (s,r)=f.post(&start).await;assert_allow(s,&r);
+    let hook=json!({"session_id":"review-host","hook_event_name":"PreToolUse","tool_name":"Bash","tool_input":{"command":"echo harmless"},"agent_id":"worker"});
+    let (_,r)=post(f.state.clone(),"/hook",&hook,Some(HOOK_TOKEN)).await;assert_eq!(r,json!({}),"control: valid grant remains useful");
+    tokio::time::sleep(std::time::Duration::from_millis(550)).await;
+    let (_,r)=f.post(&f.call("short-child","read_document",&json!({}))).await;
+    assert_eq!(r["error_code"],"native_child_authority_expired","control: grant really expired");
+    let (_,r)=post(f.state.clone(),"/hook",&hook,Some(HOOK_TOKEN)).await;
+    assert_eq!(r["hookSpecificOutput"]["permissionDecision"],"deny","expired native authority still authorizes hook: {r}");
+}
