+#[tokio::test]
+async fn review36_missing_parent_must_not_register_child_as_root() {
+    let f = Fixture::new(ALLOW);
+    let (s,r)=review8dd_start(&f,"orphan","worker",Some("nonexistent-parent"),&["delete_document"],Some(vec![])).await;
+    if s != StatusCode::OK || r["release"] != true {return;}
