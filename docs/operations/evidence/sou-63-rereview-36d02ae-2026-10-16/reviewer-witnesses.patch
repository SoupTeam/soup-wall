+#[tokio::test]
+async fn review36_parent_end_must_not_drop_resource_constraints() {
+    let f=Fixture::new(ALLOW);
+    let (s,r)=review8dd_start(&f,"parent","parent-agent",None,&["send_email"],Some(vec!["internal.corp".into()])).await;
+    assert_allow(s,&r);
+    let (s,r)=review8dd_start(&f,"blocked-child","worker",Some("parent-agent"),&["send_email"],Some(vec!["attacker.invalid".into()])).await;
+    assert!(s != StatusCode::OK || r["release"] != true,"control must reject escalation: {r}");
+    let (s,r)=f.post(&f.event("parent","session_end")).await;
+    assert_allow(s,&r);
+    let (s,r)=review8dd_start(&f,"after-end","worker",Some("parent-agent"),&["send_email"],Some(vec!["attacker.invalid".into()])).await;
+    if s != StatusCode::OK || r["release"] != true{return;}
+    let (s,r)=f.post(&f.call("after-end","send_email",&json!({"to":"outside@attacker.invalid"}))).await;
+    assert!(s != StatusCode::OK || r["release"] != true,"ending parent erased destination narrowing but retained tool grant: {r}");
+}
