+async fn review8dd_start(f: &Fixture, session: &str, agent: &str, parent: Option<&str>, tools: &[&str], resources: Option<Vec<String>>) -> (StatusCode, Value) {
+    use agentfw::native::child_authority as ca;
+    let now = SystemTime::now().duration_since(UNIX_EPOCH).unwrap().as_millis() as u64;
+    let grant = ca::mint_scoped(&ca::derive_key(NATIVE_TOKEN), "review-host", "resource-fixture", &tools.iter().map(|s|s.to_string()).collect::<Vec<_>>(), now, 60_000, session.into(), Some(agent.into()), parent.map(str::to_owned), resources);
+    let mut start = f.event(session,"session_start");
+    start["host_session"] = json!("review-host");
+    start["server_id"] = json!("resource-fixture");
+    start["child_authority"] = json!(ca::encode_token(&grant));
+    f.post(&start).await
+}
+
+#[tokio::test]
+async fn review8dd_parent_claim_without_host_must_verify_signature() {
+    let f = Fixture::new(ALLOW);
+    let mut start = f.event("forged-child", "session_start");
+    start["agent_id"] = json!("forged-worker");
+    start["parent_id"] = json!("victim-parent");
+    start["child_authority"] = json!("not-a-valid-signature");
+    let (s,r) = f.post(&start).await;
+    assert!(s != StatusCode::OK || r["release"] != true, "unsigned identity accepted: {r}");
+}
+
+#[tokio::test]
+async fn review8dd_child_must_not_exceed_registered_parent() {
+    let f = Fixture::new(ALLOW);
+    let (s,r) = review8dd_start(&f,"parent-session","narrow-parent",None,&["read_document"],Some(vec![])).await;
+    assert_allow(s,&r);
+    let (s,r) = review8dd_start(&f,"overbroad-child","worker",Some("narrow-parent"), &["delete_document"],Some(vec![])).await;
+    if s != StatusCode::OK || r["release"] != true { return; }
+    let (s,r) = f.post(&f.call("overbroad-child","delete_document",&json!({}))).await;
+    assert!(s != StatusCode::OK || r["release"] != true, "child exceeded actual parent grant: {r}");
+}
