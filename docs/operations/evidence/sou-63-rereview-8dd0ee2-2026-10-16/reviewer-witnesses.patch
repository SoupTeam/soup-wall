+#[tokio::test]
+async fn review8dd_missing_resources_must_not_allow_network() {
+    let f = Fixture::new(ALLOW);
+    let (s,r) = review8dd_start(&f,"missing-scope","mailer",None,&["send_email"],None).await;
+    if s != StatusCode::OK || r["release"] != true { return; }
+    let (s,r) = f.post(&f.call("missing-scope","send_email",&json!({"to":"outside@attacker.invalid"}))).await;
+    assert!(s != StatusCode::OK || r["release"] != true, "unprovable destination scope allowed: {r}");
+}
