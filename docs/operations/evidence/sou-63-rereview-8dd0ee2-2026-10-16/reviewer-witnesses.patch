+#[tokio::test]
+async fn review8dd_exact_granted_url_must_remain_usable() {
+    let url="http://127.0.0.1:8000/allowed";
+    let permitted=url_resource(url);
+    let (f,profile)=resource_fixture("retrieve_page","/url","url",json!([permitted["resource"]]));
+    let (s,r)=review8dd_start(&f,"url-child","reader",None,&["retrieve_page"],Some(vec![url.into()])).await;
+    assert_allow(s,&r);
+    let body=resource_call(&f,"url-child","retrieve_page",json!({"url":url}),resource_context(&profile,json!([permitted])));
+    let (s,r)=f.post(&body).await;
+    assert_eq!(s,StatusCode::OK,"exact granted URL refused: {r}");
+    assert_eq!(r["release"],true,"exact granted URL refused: {r}");
+}
