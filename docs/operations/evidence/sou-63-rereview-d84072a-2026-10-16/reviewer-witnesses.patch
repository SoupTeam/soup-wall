+#[tokio::test]
+async fn rereview_hook_reader_must_be_bounded_before_authentication() {
+    use std::sync::atomic::{AtomicUsize, Ordering};
+    let f = Fixture::configured(ALLOW, Config { enforce:true, max_body_bytes:1024, ..Config::default() });
+    let pulled = Arc::new(AtomicUsize::new(0));
+    let seen = pulled.clone();
+    let chunks = futures_util::stream::iter((0..8).map(move |_| {
+        seen.fetch_add(1, Ordering::SeqCst);
+        Ok::<_,std::io::Error>(vec![b'x';1024])
+    }));
+    let response = app(f.state.clone()).oneshot(Request::builder().method("POST").uri("/hook")
+        .header("content-type","application/json").body(Body::from_stream(chunks)).unwrap()).await.unwrap();
+    assert_eq!(response.status(), StatusCode::UNAUTHORIZED);
+    assert!(pulled.load(Ordering::SeqCst)<=2,
+        "unauthenticated reader consumed {} KiB despite a 1 KiB configured cap",pulled.load(Ordering::SeqCst));
+}
