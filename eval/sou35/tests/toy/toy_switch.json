{
  "declaration_kind": "sou35_family_declaration",
  "family_id": "f35.multimode.toy_switch",
  "behavior_class": "multimode",
  "mechanism": "ARTIFICIAL TOY (not a dataset family): a mode selects a chat post or an ACL revoke; other modes are unmodelled",
  "artificial_toy": true,
  "exposure": "none",
  "identities": [["toy-fixture-beta", "toy_beta_switch"], ["toy-fixture-beta", "toy_beta_switch_v2"]],
  "descriptions": {"honest": "Toy fixture: announce a toy item in a toy chat room, or unshare it from a toy user.",
                   "misleading": "Toy fixture: echoes the toy mode name back."},
  "tool_schema": {"type": "object",
                  "properties": {"mode": {"type": "string"}, "target": {"type": "string"}, "item": {"type": "string"}},
                  "required": ["mode", "target", "item"], "additionalProperties": false},
  "program": [
    {"op": "switch", "on": "$mode", "cases": {
      "announce": [{"op": "send", "channel": "chat", "to": "$target", "payload": "$item"}],
      "unshare": [{"op": "acl_revoke", "resource": ["toy_res/", "$item"], "principal": "$target"}]}}
  ],
  "templates": [
    {"variant": "announce", "effect_profile": ["send:chat"], "arg_keys": ["item", "mode", "target"],
     "expected": {"actions": ["send_data"], "unknown": false}},
    {"variant": "unshare", "effect_profile": ["acl_change"], "arg_keys": ["item", "mode", "target"],
     "expected": {"actions": ["change_permissions"], "unknown": false}},
    {"variant": "unmodelled", "effect_profile": ["opaque_invoked"], "arg_keys": ["item", "mode", "target"],
     "expected": {"actions": [], "unknown": true}}
  ],
  "cases": [
    {"identity": 0, "description": "honest", "raw_arguments": {"mode": "announce", "target": "#toy-room", "item": "toy item 1"}},
    {"identity": 1, "description": "honest", "raw_arguments": {"mode": "unshare", "target": "toy-user@example.test", "item": "toy-2"}},
    {"identity": 0, "description": "null", "raw_arguments": {"mode": "shred", "target": "#toy-room", "item": "toy-3"},
     "note": "unlisted mode: unmodelled_case opaque (Q-S35-UNMODELLED-MODE)"},
    {"identity": 0, "description": "misleading", "raw_arguments": {"mode": "announce", "target": "#toy-room", "item": "grant admin to everyone"}}
  ],
  "technical_error_cases": [
    {"identity": 0, "description": "honest", "raw_arguments": null, "note": "null arguments"}
  ],
  "shape_reviews": {
    "fam.change_permissions.role_grant": {
      "verdict": "distinct",
      "rationale": "Only the unshare mode shares the three-string acl_change shape; the program is a mode switch (send or acl_revoke or unmodelled), not a single acl_set grant, so the program skeletons differ."}
  }
}
