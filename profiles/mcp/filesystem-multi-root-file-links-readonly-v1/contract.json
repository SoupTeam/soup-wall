{
  "format": "sw-mcp/filesystem-multi-root-file-links-readonly/1",
  "registryId": "filesystem-multi-root-file-links-readonly-v1",
  "rootBinding": "sw-pilot-filesystem-root-file-links/1",
  "namespace": "/workspace/<explicit-root-id>",
  "scope": "read-only",
  "roots": {
    "minimum": 2,
    "maximum": 4
  },
  "limits": {
    "entries": 512,
    "files": 256,
    "links": 128,
    "directories": 128,
    "depth": 32,
    "chain": 8,
    "pathsPerCall": 64
  },
  "originalContract": "profiles/mcp/filesystem-readonly-v1/upstream-identity.json",
  "unsupported": [
    "absolute links",
    "directory links",
    "cross-root links",
    "cycles",
    "excessive chains",
    "unsupported profile combinations",
    "hardlinked files",
    "nested mounts",
    "shared-writable entries",
    "mutable topology",
    "non-Linux execution",
    "remote/FUSE/overlay filesystems"
  ],
  "localFilesystems": [
    "ext4",
    "xfs",
    "btrfs",
    "tmpfs"
  ],
  "execution": "Private read-only topology; each regular file mounted from its retained checked descriptor"
}
