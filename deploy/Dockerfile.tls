FROM rust:1.99-bookworm@sha256:e6f2cff35d0f309acf8433b4f05878ed77092602c5065cc81801177da0bb3a9c AS build
ENV RUSTUP_TOOLCHAIN=1.99.0
WORKDIR /src
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates ./crates
COPY vendor ./vendor
RUN --mount=type=cache,id=sou38-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=sou38-target,target=/src/target \
    cargo build --locked --release -p llm-firewall \
    && cp target/release/llm-firewall /soup-wall-gateway

FROM caddy:2.11.9-alpine@sha256:0bbb055bda6793c999bde78b1b5ce3e89f829fb031af2cf50056ea1246559fee AS edge

FROM python:3.15-slim-bookworm@sha256:96599df822d0e1c6bb700014a05c7f3c8cabc6e0f7ff3c4f9f69cee033b4b5d9
COPY --from=build /soup-wall-gateway /usr/local/bin/soup-wall-gateway
COPY --from=edge /usr/bin/caddy /usr/local/bin/caddy
RUN cp /usr/local/bin/caddy /tmp/caddy && mv /tmp/caddy /usr/local/bin/caddy
COPY LICENSE NOTICE /usr/share/doc/soup-wall/
COPY vendor/kryptering/LICENSE /usr/share/doc/soup-wall/third-party/kryptering/LICENSE
ENV PYTHONDONTWRITEBYTECODE=1 HOME=/tmp
ARG SOURCE_SHA256
LABEL soup-wall.tls.source-sha256=$SOURCE_SHA256
ENTRYPOINT ["python", "/source/scripts/tls-lifecycle.py", "--inside"]
